    { "name": "add-date-plus-time", "args": ["add", "带时间任务", "--due", "2026-10-01", "--time", "09:05", "--json"] },
    { "name": "add-time-override",
      "args": ["add", "时间覆盖", "--due", "@9am tomorrow", "--time", "23:45", "--json"] },

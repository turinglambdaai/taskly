    { "name": "update-list-move", "args": ["update", "2", "--list", "2", "--json"] },
    { "name": "update-notes-clear", "args": ["update", "4", "--clear-notes", "--json"] },
    { "name": "update-unknown", "args": ["update", "999", "--text", "x", "--json"] },
    { "name": "update-bad-due", "args": ["update", "1", "--due", "罢工", "--json"] },


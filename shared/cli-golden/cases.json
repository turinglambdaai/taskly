    { "name": "search-miss", "args": ["search", "ZZZ", "--json"] },
    { "name": "search-completed-included", "args": ["search", "历史", "--json"] },

    { "name": "mklist-full", "args": ["mklist", "测试清单", "--icon", "🎯", "--color", "#FF0000", "--json"] },
    { "name": "mklist-defaults", "args": ["mklist", "默认清单", "--json"] },
    { "name": "mklist-int-color", "args": ["mklist", "整数色", "--color", "12345", "--json"] },
    { "name": "mklist-bad-color", "args": ["mklist", "坏色", "--color", "#GGG", "--json"] },
    { "name": "mklist-empty-name", "args": ["mklist", "", "--json"] },

    { "name": "unknown-command", "args": ["badcmd", "--json"] },
    { "name": "help", "args": ["--help"] },
    { "name": "db-unopenable", "args": ["list", "--json", "--db", "/nonexistent-dir-for-golden/x.db"] }

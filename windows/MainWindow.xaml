<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Taskly">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="TasklySidebarBrush" Color="#F3F2F1" />
                        <SolidColorBrush x:Key="TasklySurfaceBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="TasklyDividerBrush" Color="#E1DFDD" />
                        <SolidColorBrush x:Key="TasklySelectedBrush" Color="#E8E4E0" />
                        <SolidColorBrush x:Key="TasklySelectionBrush" Color="#14000000" />
                        <SolidColorBrush x:Key="TasklyHoverBrush" Color="#EBE9E7" />
                        <SolidColorBrush x:Key="TasklyAccentBrush" Color="#C94F30" />
                        <SolidColorBrush x:Key="TasklyAccentSoftBrush" Color="#14C94F30" />
                        <SolidColorBrush x:Key="TasklyDueTodayBrush" Color="#C4501B" />
                        <SolidColorBrush x:Key="TasklyOverdueBrush" Color="#D13438" />
                        <SolidColorBrush x:Key="TasklySecondaryTextBrush" Color="#5F5D5B" />
                        <SolidColorBrush x:Key="TasklyMutedTextBrush" Color="#767370" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="TasklySidebarBrush" Color="#272424" />
                        <SolidColorBrush x:Key="TasklySurfaceBrush" Color="#323234" />
                        <SolidColorBrush x:Key="TasklyDividerBrush" Color="#3B3939" />
                        <SolidColorBrush x:Key="TasklySelectedBrush" Color="#3A3736" />
                        <SolidColorBrush x:Key="TasklySelectionBrush" Color="#1FFFFFFF" />
                        <SolidColorBrush x:Key="TasklyHoverBrush" Color="#332F2F" />
                        <SolidColorBrush x:Key="TasklyAccentBrush" Color="#E8704F" />
                        <SolidColorBrush x:Key="TasklyAccentSoftBrush" Color="#14E8704F" />
                        <SolidColorBrush x:Key="TasklyDueTodayBrush" Color="#F2913D" />
                        <SolidColorBrush x:Key="TasklyOverdueBrush" Color="#FF6B6E" />
                        <SolidColorBrush x:Key="TasklySecondaryTextBrush" Color="#B2AEAC" />
                        <SolidColorBrush x:Key="TasklyMutedTextBrush" Color="#A8A5A3" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <!-- Smart-tile view colors (DESIGN-TOKENS, theme-independent);
                     looked up from code via RootGrid resources. -->
                <SolidColorBrush x:Key="TasklyTileTodayBrush" Color="#007AFF" />
                <SolidColorBrush x:Key="TasklyTilePlannedBrush" Color="#FF3B30" />
                <SolidColorBrush x:Key="TasklyTileAllBrush" Color="#8E8E93" />
                <SolidColorBrush x:Key="TasklyTileCompletedBrush" Color="#8E8E93" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File" x:Name="MenuFile">
                <MenuFlyoutItem x:Name="MenuNewDatabase" Click="OnNewDatabase" />
                <MenuFlyoutItem x:Name="MenuOpenDatabase" Click="OnOpenDatabase" />
                <MenuFlyoutItem x:Name="MenuCloseDatabase" Click="OnCloseDatabase" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuExit" Click="OnExit" />
            </MenuBarItem>
            <MenuBarItem Title="Settings" x:Name="MenuSettings">
                <MenuFlyoutItem x:Name="MenuLangZh" Click="OnLangZh" />
                <MenuFlyoutItem x:Name="MenuLangEn" Click="OnLangEn" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="MenuTheme">
                    <MenuFlyoutItem x:Name="MenuThemeSystem" Click="OnThemeSystem" />
                    <MenuFlyoutItem x:Name="MenuThemeLight" Click="OnThemeLight" />
                    <MenuFlyoutItem x:Name="MenuThemeDark" Click="OnThemeDark" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="MenuAutoCheckUpdates" Click="OnAutoCheckUpdatesToggled" />
            </MenuBarItem>
            <MenuBarItem Title="Help" x:Name="MenuHelp">
                <!-- Family menu convention: Check for Updates… and About are
                     a pair in the Help menu. -->
                <MenuFlyoutItem x:Name="MenuCheckUpdates" Click="OnCheckUpdates" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuAbout" Click="OnAbout" />
            </MenuBarItem>
        </MenuBar>

        <!-- Update download notice: full-width above the body. The status
             bar line alone was too easy to miss during a multi-minute
             download (user feedback, 0.2.1). -->
        <InfoBar
            x:Name="UpdateDownloadBar"
            Grid.Row="1"
            Margin="12,8,12,0"
            IsOpen="False"
            IsClosable="False"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button x:Name="UpdateDownloadCancel" Click="OnCancelUpdateDownload" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <ProgressBar
                    x:Name="UpdateDownloadProgress"
                    Margin="0,0,16,10"
                    Minimum="0"
                    Maximum="100"
                    IsIndeterminate="True" />
            </InfoBar.Content>
        </InfoBar>

        <!-- Body: sidebar | task pane -->
        <Grid x:Name="BodyGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: lists (search lives in the pane header) -->
            <Grid x:Name="SidebarPane" Grid.Column="0" Background="{ThemeResource TasklySidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 2×2 smart-view tiles (DESIGN-TOKENS smart-list chip:
                             34px neutral chip, radius 8, 8px gaps, colored glyph
                             + 13px label + quiet 12px count right). -->
                        <Grid x:Name="SmartTileGrid" Margin="12,4,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Height" Value="34" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                            </Grid.Resources>
                            <Button x:Name="TileToday" Margin="0,0,8,8" Click="OnSmartTileClick">
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="TileTodayGlyph" FontSize="14" />
                                    <TextBlock
                                        x:Name="TileTodayLabel"
                                        Grid.Column="1"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="TileTodayCount"
                                        AutomationProperties.AutomationId="smart-count-today"
                                        Grid.Column="2"
                                        FontSize="12"
                                        Foreground="{ThemeResource TasklySecondaryTextBrush}" />
                                </Grid>
                            </Button>
                            <Button x:Name="TilePlanned" Grid.Column="1" Margin="0,0,0,8" Click="OnSmartTileClick">
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="TilePlannedGlyph" FontSize="14" />
                                    <TextBlock
                                        x:Name="TilePlannedLabel"
                                        Grid.Column="1"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="TilePlannedCount"
                                        AutomationProperties.AutomationId="smart-count-planned"
                                        Grid.Column="2"
                                        FontSize="12"
                                        Foreground="{ThemeResource TasklySecondaryTextBrush}" />
                                </Grid>
                            </Button>
                            <Button x:Name="TileAll" Grid.Row="1" Margin="0,0,8,0" Click="OnSmartTileClick">
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="TileAllGlyph" FontSize="14" />
                                    <TextBlock
                                        x:Name="TileAllLabel"
                                        Grid.Column="1"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="TileAllCount"
                                        AutomationProperties.AutomationId="smart-count-all"
                                        Grid.Column="2"
                                        FontSize="12"
                                        Foreground="{ThemeResource TasklySecondaryTextBrush}" />
                                </Grid>
                            </Button>
                            <Button x:Name="TileCompleted" Grid.Row="1" Grid.Column="1" Click="OnSmartTileClick">
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="TileCompletedGlyph" FontSize="14" />
                                    <TextBlock
                                        x:Name="TileCompletedLabel"
                                        Grid.Column="1"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="TileCompletedCount"
                                        AutomationProperties.AutomationId="smart-count-completed"
                                        Grid.Column="2"
                                        FontSize="12"
                                        Foreground="{ThemeResource TasklySecondaryTextBrush}" />
                                </Grid>
                            </Button>
                        </Grid>

                        <!-- My Lists section header with the ✚ create button
                             (PRODUCT-SPEC §3). -->
                        <Grid Margin="16,14,12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="MyListsHeader"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TasklySecondaryTextBrush}" />
                            <Button
                                x:Name="NewListButton"
                                AutomationProperties.AutomationId="create-list"
                                Grid.Column="1"
                                Padding="6,2"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnNewList">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                            </Button>
                        </Grid>
                        <ListView
                            x:Name="UserList"
                            SelectionMode="Single"
                            SelectionChanged="OnUserListSelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="36" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <Border
                x:Name="SidebarDivider"
                Grid.Column="1"
                Width="1"
                HorizontalAlignment="Center"
                Background="{ThemeResource TasklyDividerBrush}" />

            <!-- Task pane -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,10,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Sidebar collapse toggle (PRODUCT-SPEC §2) -->
                    <Button
                        x:Name="SidebarToggle"
                        Padding="6"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnSidebarToggle">
                        <FontIcon
                            x:Name="SidebarToggleGlyph"
                            FontSize="14"
                            Foreground="{ThemeResource TasklySecondaryTextBrush}" />
                    </Button>
                    <!-- Large title + secondary subtitle line (DESIGN-TOKENS
                         view header): subtitle sits beneath the title. -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2"
                        Margin="10,0,12,0">
                        <TextBlock
                            x:Name="PaneTitle"
                            AutomationProperties.AutomationId="current-view-title"
                            FontSize="22"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="PaneSubtitle"
                            FontSize="13"
                            Foreground="{ThemeResource TasklySecondaryTextBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBox
                            x:Name="SearchBox"
                            AutomationProperties.AutomationId="task-search"
                            Width="200"
                            Height="28"
                            CornerRadius="10"
                            VerticalContentAlignment="Center"
                            UseSystemFocusVisuals="False"
                            TextChanged="OnSearchTextChanged" />
                        <CheckBox
                            x:Name="ShowCompletedCheck"
                            VerticalAlignment="Center"
                            Checked="OnShowCompletedChanged"
                            Unchecked="OnShowCompletedChanged" />
                    </StackPanel>
                </Grid>

                <!-- Shown only for multi-selected task rows; a shared action
                     bar works in both the normal and global-search panes. -->
                <StackPanel x:Name="BulkActionBar"
                            Grid.Row="1"
                            AutomationProperties.AutomationId="bulk-actions"
                            Visibility="Collapsed"
                            Orientation="Horizontal"
                            Margin="24,0,24,8"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <TextBlock x:Name="BulkSelectionCount"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TasklySecondaryTextBrush}" />
                    <Button x:Name="BulkCompleteButton"
                            AutomationProperties.AutomationId="bulk-complete"
                            Click="OnBulkCompleteClicked" />
                    <Button x:Name="BulkMoveButton"
                            AutomationProperties.AutomationId="bulk-move"
                            Click="OnBulkMoveClicked" />
                    <Button x:Name="BulkScheduleButton"
                            AutomationProperties.AutomationId="bulk-schedule"
                            Click="OnBulkScheduleClicked" />
                    <Button x:Name="BulkDeleteButton"
                            AutomationProperties.AutomationId="bulk-delete"
                            Click="OnBulkDeleteClicked" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <!-- Normal view -->
                    <StackPanel x:Name="NormalPane">
                        <!-- Quick-add card: accent plus button + live parse
                             preview capsule (macOS TaskPaneView inputArea). -->
                        <Border
                            x:Name="QuickAddCard"
                            Margin="24,4,24,10"
                            CornerRadius="12"
                            Background="{ThemeResource TasklySurfaceBrush}"
                            BorderBrush="{ThemeResource TasklyDividerBrush}"
                            BorderThickness="1">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="QuickAddButton"
                                    AutomationProperties.AutomationId="quick-add-submit"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    Padding="0"
                                    CornerRadius="11"
                                    Background="{ThemeResource TasklyAccentBrush}"
                                    BorderThickness="0"
                                    Click="OnQuickAddCommit">
                                    <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="White" />
                                </Button>
                                <TextBox
                                    x:Name="NewTaskBox"
                                    AutomationProperties.AutomationId="quick-add"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    MinHeight="40"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    UseSystemFocusVisuals="False"
                                    VerticalContentAlignment="Center"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Padding="10,10,10,10"
                                    KeyDown="OnNewTaskKeyDown"
                                    TextChanged="OnNewTaskTextChanged"
                                    GotFocus="OnNewTaskFocusChanged"
                                    LostFocus="OnNewTaskFocusChanged">
                                    <!-- The surrounding QuickAddCard owns the input border.
                                         WinUI's stock TextBox focused underline must not
                                         draw a second blue rule along this card's bottom. -->
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    </TextBox.Resources>
                                </TextBox>
                                <Border
                                    x:Name="QuickAddPreview"
                                    Grid.Column="2"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    CornerRadius="999"
                                    Background="{ThemeResource TasklyAccentSoftBrush}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            Glyph="&#xE787;"
                                            FontSize="10"
                                            Foreground="{ThemeResource TasklyAccentBrush}" />
                                        <TextBlock
                                            x:Name="QuickAddPreviewText"
                                            FontSize="12"
                                            Foreground="{ThemeResource TasklyAccentBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListView
                                x:Name="TaskList"
                                AutomationProperties.AutomationId="task-list"
                                Margin="16,0,16,16"
                                SelectionMode="Extended"
                                SelectionChanged="OnTaskSelectionChanged"
                                KeyDown="OnTaskListKeyDown">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="44" />
                                        <Setter Property="Padding" Value="8,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Search results -->
                    <ScrollViewer
                        x:Name="SearchPane"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto">
                        <ListView
                            x:Name="SearchResults"
                            AutomationProperties.AutomationId="search-task-list"
                            Margin="24,8,24,16"
                            SelectionMode="Extended"
                            SelectionChanged="OnTaskSelectionChanged"
                            KeyDown="OnTaskListKeyDown">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="44" />
                                    <Setter Property="Padding" Value="8,2" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </ScrollViewer>

                    <!-- Connected-empty state (PRODUCT-SPEC §5: ✓ + taskListEmpty) -->
                    <StackPanel
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="EmptyStateIcon"
                            HorizontalAlignment="Center"
                            FontSize="28"
                            Foreground="{ThemeResource TasklyMutedTextBrush}" />
                        <TextBlock
                            x:Name="EmptyStateText"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TasklySecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{ThemeResource TasklySidebarBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock
                    x:Name="StatusText"
                    Margin="12,4"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TasklySecondaryTextBrush}"
                    TextTrimming="CharacterEllipsis" />
                <Button x:Name="UndoDeleteButton"
                        AutomationProperties.AutomationId="undo-delete"
                        Click="OnUndoDeleteClicked"
                        Visibility="Collapsed"
                        MinWidth="58"
                        Padding="10,2" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

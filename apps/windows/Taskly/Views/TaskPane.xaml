<UserControl
    x:Class="Taskly.Views.TaskPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Taskly.Views"
    Background="{ThemeResource ThemeBackgroundBrush}">

    <UserControl.Resources>
        <!-- Shared §5 task-row template: the flat list and the calendar
             time line must stay visually identical (PRODUCT-SPEC §4b). -->
        <DataTemplate x:Key="TaskRowTemplate">
            <Grid Padding="16,12" CornerRadius="10" Background="Transparent"
                  PointerEntered="OnTaskPointerEntered" PointerExited="OnTaskPointerExited"
                  ContextRequested="OnTaskContextRequested">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="OnToggleCompleted"
                        Background="Transparent" BorderThickness="0" Padding="4"
                        VerticalAlignment="Top">
                    <Grid Width="20" Height="20">
                        <Ellipse Width="20" Height="20" StrokeThickness="1.5">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="{Binding RingColor}" />
                            </Ellipse.Stroke>
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding RingFill}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <FontIcon Glyph="&#xE73E;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="White"
                                  Visibility="{Binding CheckVisibility}" />
                    </Grid>
                </Button>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
                    <TextBlock Text="{Binding Text}" FontSize="14"
                               Foreground="{Binding TextBrush}"
                               TextDecorations="{Binding Decorations}"
                               TextWrapping="Wrap" MaxLines="3" />
                    <TextBlock Text="{Binding DueText}" FontSize="12"
                               Foreground="{Binding DueBrush}"
                               Visibility="{Binding MetaVisibility}" />
                    <TextBlock Text="{Binding NotesText}" FontSize="12"
                               Foreground="{ThemeResource ThemeTertiaryTextBrush}"
                               Visibility="{Binding NotesVisibility}"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="2" Click="OnOpenDetail"
                        Background="Transparent" BorderThickness="0" Padding="4"
                        VerticalAlignment="Top" Opacity="0.45">
                    <FontIcon Glyph="&#xE946;" FontSize="14"
                              Foreground="{ThemeResource ThemeTertiaryTextBrush}" />
                </Button>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 1: toolbar (sidebar toggle | search) — Reminders layout.
             Show Completed lives in the View menu. -->
        <Grid Grid.Row="0" Padding="10,6,14,0" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SidebarToggle" Grid.Column="0" Click="OnToggleSidebar"
                    AutomationProperties.Name="Toggle sidebar"
                    Background="Transparent" BorderThickness="0" Padding="6"
                    Content="&#xE700;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    VerticalAlignment="Center" />

        </Grid>

        <!-- Row 1: large view title + subtitle (Reminders puts the title in
             its own block under the toolbar). -->
        <StackPanel Grid.Row="1" Margin="20,2,16,6">
            <TextBlock x:Name="TitleText"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{ThemeResource ThemeOnSurfaceBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SubtitleText"
                       FontSize="13" Margin="0,2,0,0"
                       Foreground="{ThemeResource ThemeSecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Quick add: the pane's single, prominent input -->
        <StackPanel x:Name="InputArea" Grid.Row="2" Padding="16,4,16,10">
            <Grid x:Name="QuickAddArea" Padding="12,0" Height="40" CornerRadius="10"
                  Background="{ThemeResource ThemeSurfaceBrush}"
                  BorderBrush="{ThemeResource ThemeInputBorderBrush}" BorderThickness="1">
                <TextBox x:Name="QuickAddBox"
                         BorderThickness="0" Background="Transparent" FontSize="14"
                         VerticalAlignment="Center" MinHeight="0"
                         KeyDown="OnQuickAddKeyDown" />
            </Grid>
        </StackPanel>

        <!-- Task list / empty states -->
        <Grid Grid.Row="3">
            <ListView x:Name="TasksList" SelectionMode="Single"
                      Background="Transparent"
                      IsDoubleTapEnabled="True"
                      DoubleTapped="OnTaskDoubleTapped"
                      ItemTemplate="{StaticResource TaskRowTemplate}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="CornerRadius" Value="10" />
                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <!-- Reminders-style selection: quiet fill,
                                         never the default accent block. WinUI
                                         templates use VSM, not WPF triggers. -->
                                    <Grid x:Name="Root">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowBackground" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ThemeHoverBackgroundBrush}" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowBackground" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ThemeSelectionBackgroundBrush}" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="PointerOverSelected">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowBackground" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ThemeSelectionBackgroundBrush}" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border x:Name="RowBackground"
                                                CornerRadius="10"
                                                Background="Transparent" />
                                        <ContentPresenter />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock x:Name="EmptyIcon" FontSize="48" TextAlignment="Center" Opacity="0.35" />
                <TextBlock x:Name="EmptyText" TextAlignment="Center" FontSize="14"
                           Foreground="{ThemeResource ThemeTertiaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

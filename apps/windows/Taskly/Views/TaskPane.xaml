<UserControl
    x:Class="Taskly.Views.TaskPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ThemeBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SidebarToggle" Grid.Column="0" Click="OnToggleSidebar"
                    Background="Transparent" BorderThickness="0" Padding="6"
                    Content="&#xE700;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />

            <TextBlock x:Name="TitleText" Grid.Column="1"
                       FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                       Foreground="{ThemeResource ThemeOnSurfaceBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

            <Button x:Name="ShowCompletedToggle" Grid.Column="2" Click="OnToggleShowCompleted"
                    Background="Transparent" BorderThickness="0" Padding="4" />
        </Grid>

        <!-- Inputs: search + quick add -->
        <StackPanel x:Name="InputArea" Grid.Row="1" Padding="16,4,16,10" Spacing="8">
            <Grid Padding="10,6" CornerRadius="8"
                  Background="{ThemeResource ThemeSurfaceBrush}"
                  BorderBrush="{ThemeResource ThemeInputBorderBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="12"
                          Foreground="{ThemeResource ThemeTertiaryTextBrush}" />
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         BorderThickness="0" Background="Transparent" FontSize="13"
                         KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged" />
            </Grid>

            <Grid x:Name="QuickAddArea" Padding="12,9" CornerRadius="8"
                  Background="{ThemeResource ThemeSurfaceBrush}"
                  BorderBrush="{ThemeResource ThemeInputBorderBrush}" BorderThickness="1">
                <TextBox x:Name="QuickAddBox"
                         BorderThickness="0" Background="Transparent" FontSize="14"
                         KeyDown="OnQuickAddKeyDown" />
            </Grid>
        </StackPanel>

        <!-- Task list / empty states -->
        <Grid Grid.Row="2">
            <ListView x:Name="TasksList" SelectionMode="None"
                      Background="Transparent"
                      IsDoubleTapEnabled="True"
                      DoubleTapped="OnTaskDoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="16,10" CornerRadius="10" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="OnToggleCompleted"
                                    Background="Transparent" BorderThickness="0" Padding="4"
                                    VerticalAlignment="Top">
                                <Ellipse Width="18" Height="18" StrokeThickness="1.5">
                                    <Ellipse.Stroke>
                                        <SolidColorBrush Color="{Binding RingColor}" />
                                    </Ellipse.Stroke>
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding RingFill}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Button>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
                                <TextBlock Text="{Binding Text}" FontSize="14"
                                           Foreground="{Binding TextBrush}"
                                           TextDecorations="{Binding Decorations}"
                                           TextWrapping="Wrap" MaxLines="3" />
                                <TextBlock Text="{Binding DueText}" FontSize="12"
                                           Foreground="{ThemeResource ThemeSecondaryTextBrush}"
                                           Visibility="{Binding MetaVisibility}" />
                                <TextBlock Text="{Binding NotesText}" FontSize="12"
                                           Foreground="{ThemeResource ThemeTertiaryTextBrush}"
                                           Visibility="{Binding NotesVisibility}"
                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="2" Click="OnOpenDetail"
                                    Background="Transparent" BorderThickness="0" Padding="4"
                                    VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE946;" FontSize="14"
                                          Foreground="{ThemeResource ThemeTertiaryTextBrush}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock x:Name="EmptyIcon" FontSize="48" TextAlignment="Center" Opacity="0.35" />
                <TextBlock x:Name="EmptyText" TextAlignment="Center" FontSize="14"
                           Foreground="{ThemeResource ThemeTertiaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

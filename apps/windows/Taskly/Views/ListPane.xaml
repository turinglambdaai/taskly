<UserControl
    x:Class="Taskly.Views.ListPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ThemeSidebarBrush}">

    <UserControl.Resources>
        <!-- Smart-list chip (macOS Reminders language): neutral surface,
             colored glyph, quiet count. Chrome-free ToggleButton so hover
             and checked states are VSM-driven and keyboard/UIA work. -->
        <Style x:Key="SmartChip" TargetType="ToggleButton">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="34" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipSurface" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ThemeHoverBackgroundBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipSurface" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ThemeSelectionBackgroundBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MouseOverChecked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipSurface" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ThemeSelectionBackgroundBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="ChipSurface"
                                    CornerRadius="8"
                                    Background="{ThemeResource ThemeSurfaceBrush}"
                                    BorderBrush="{ThemeResource ThemeDividerBrush}"
                                    BorderThickness="1" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipGlyph" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource ThemeOnSurfaceBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ChipCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource ThemeSecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12" Spacing="12">

            <!-- Search sits inside the sidebar, above the smart-list chips
                 (macOS Reminders placement). -->
            <Grid x:Name="SearchArea" Height="30" CornerRadius="8"
                  Background="{ThemeResource ThemeSurfaceBrush}"
                  BorderBrush="{ThemeResource ThemeInputBorderBrush}" BorderThickness="1"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="12" Margin="8,0,0,0"
                          Foreground="{ThemeResource ThemeTertiaryTextBrush}" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="4,0,4,0"
                         BorderThickness="0" Background="Transparent" FontSize="13"
                         VerticalAlignment="Center" MinHeight="0"
                         KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged" />
            </Grid>

            <!-- Smart-list chips: 2 per row, one-line content
                 (glyph + name + count) — Reminders placement. Two explicit
                 rows sidestep any Grid attached-property ambiguity. -->
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ChipToday" Grid.Column="0" Click="OnChipToday"
                                  Style="{StaticResource SmartChip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Style="{StaticResource ChipGlyph}"
                                      Foreground="{StaticResource ChipTodayGlyph}"
                                      Glyph="&#xE787;" />
                            <TextBlock x:Name="ChipTodayLabel" Style="{StaticResource ChipLabel}" />
                            <TextBlock x:Name="ChipTodayCount" Style="{StaticResource ChipCount}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ChipPlanned" Grid.Column="1" Click="OnChipPlanned"
                                  Style="{StaticResource SmartChip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Style="{StaticResource ChipGlyph}"
                                      Foreground="{StaticResource ChipPlannedGlyph}"
                                      Glyph="&#xE823;" />
                            <TextBlock x:Name="ChipPlannedLabel" Style="{StaticResource ChipLabel}" />
                            <TextBlock x:Name="ChipPlannedCount" Style="{StaticResource ChipCount}" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ChipAll" Grid.Column="0" Click="OnChipAll"
                                  Style="{StaticResource SmartChip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Style="{StaticResource ChipGlyph}"
                                      Foreground="{StaticResource ChipAllGlyph}"
                                      Glyph="&#xE8FD;" />
                            <TextBlock x:Name="ChipAllLabel" Style="{StaticResource ChipLabel}" />
                            <TextBlock x:Name="ChipAllCount" Style="{StaticResource ChipCount}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ChipCompleted" Grid.Column="1" Click="OnChipCompleted"
                                  Style="{StaticResource SmartChip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Style="{StaticResource ChipGlyph}"
                                      Foreground="{StaticResource ChipCompletedGlyph}"
                                      Glyph="&#xE73E;" />
                            <TextBlock x:Name="ChipCompletedLabel" Style="{StaticResource ChipLabel}" />
                            <TextBlock x:Name="ChipCompletedCount" Style="{StaticResource ChipCount}" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
            </StackPanel>

            <!-- My Lists header + add button -->
            <Grid Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MyListsHeader" Grid.Column="0"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource ThemeSecondaryTextBrush}"
                           VerticalAlignment="Center" />
                <Button x:Name="AddListButton" Grid.Column="1" Click="OnAddList"
                        Background="Transparent" BorderThickness="0" Padding="4,2"
                        UseSystemFocusVisuals="False">
                    <TextBlock Text="✚" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                </Button>
            </Grid>

            <ListView x:Name="ListsList" SelectionMode="None" IsItemClickEnabled="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- Compact list card: small color dot + name + count -->
                        <Border CornerRadius="8" Padding="8,5"
                                Background="{Binding CardBrush}"
                                BorderBrush="{ThemeResource ThemeDividerBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                         VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding RowColor}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{Binding IconText}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,-2,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding PendingText}" FontSize="12"
                                           Foreground="{ThemeResource ThemeSecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,2,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>

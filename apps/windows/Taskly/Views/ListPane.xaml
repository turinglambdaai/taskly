<UserControl
    x:Class="Taskly.Views.ListPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ThemeSidebarBrush}">

    <UserControl.Resources>
        <!-- 0.7.0-style smart tile: colored fill, glyph top-left, bold count
             top-right, semibold label bottom-left. -->
        <!-- Smart tiles: chrome-free buttons. A plain Border+Tapped would
             lose keyboard focus and UIA Invoke; a stock WinUI button grays
             colored fills on hover. A bare ControlTemplate keeps both. -->
        <Style x:Key="SmartTile" TargetType="Button">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Height" Value="68" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileGlyph" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TileCount" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12" Spacing="16">

            <!-- Search sits inside the sidebar, above the four filter
                 tiles — macOS Reminders placement. -->
            <Grid x:Name="SearchArea" Height="32" CornerRadius="8"
                  Background="{ThemeResource ThemeSurfaceBrush}"
                  BorderBrush="{ThemeResource ThemeInputBorderBrush}" BorderThickness="1"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="12" Margin="8,0,0,0"
                          Foreground="{ThemeResource ThemeTertiaryTextBrush}" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="4,0,4,0"
                         BorderThickness="0" Background="Transparent" FontSize="13"
                         VerticalAlignment="Center" MinHeight="0"
                         KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged" />
            </Grid>

            <!-- Smart view tiles (2×2, 0.7.0 layout): two-row geometry —
                 glyph + count on top, label at the bottom. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" x:Name="TileToday" Style="{StaticResource SmartTile}"
                        Background="{StaticResource SmartListTodayBrush}" Click="OnTileToday">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="TileTodayIcon" Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TileTodayCount" Style="{StaticResource TileCount}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TileTodayLabel" Grid.Row="1" Style="{StaticResource TileLabel}" />
                    </Grid>
                </Button>

                <Button Grid.Row="0" Grid.Column="2" x:Name="TilePlanned" Style="{StaticResource SmartTile}"
                        Background="{StaticResource SmartListScheduledBrush}" Click="OnTilePlanned">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="TilePlannedIcon" Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TilePlannedCount" Style="{StaticResource TileCount}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TilePlannedLabel" Grid.Row="1" Style="{StaticResource TileLabel}" />
                    </Grid>
                </Button>

                <Button Grid.Row="2" Grid.Column="0" x:Name="TileAll" Style="{StaticResource SmartTile}"
                        Background="{StaticResource SmartListAllBrush}" Click="OnTileAll">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="TileAllIcon" Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TileAllCount" Style="{StaticResource TileCount}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TileAllLabel" Grid.Row="1" Style="{StaticResource TileLabel}" />
                    </Grid>
                </Button>

                <Button Grid.Row="2" Grid.Column="2" x:Name="TileCompleted" Style="{StaticResource SmartTile}"
                        Background="{StaticResource SmartListCompletedBrush}" Click="OnTileCompleted">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="TileCompletedIcon" Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TileCompletedCount" Style="{StaticResource TileCount}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TileCompletedLabel" Grid.Row="1" Style="{StaticResource TileLabel}" />
                    </Grid>
                </Button>
            </Grid>

            <!-- My Lists header + add button (0.7.0 layout) -->
            <Grid Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MyListsHeader" Grid.Column="0"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource ThemeSecondaryTextBrush}"
                           VerticalAlignment="Center" />
                <Button x:Name="AddListButton" Grid.Column="1" Click="OnAddList"
                        Background="Transparent" BorderThickness="0" Padding="4,2"
                        UseSystemFocusVisuals="False">
                    <TextBlock Text="✚" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                </Button>
            </Grid>

            <ListView x:Name="ListsList" SelectionMode="None" IsItemClickEnabled="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- 0.7.0 card row: surface fill + hairline border so rows
                             read as containers; emoji sits inside the color dot. -->
                        <Border CornerRadius="8" Padding="10,8"
                                Background="{ThemeResource ThemeSurfaceBrush}"
                                BorderBrush="{ThemeResource ThemeDividerBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding RowColor}" />
                                    </Border.Background>
                                    <TextBlock Text="{Binding IconText}" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding PendingText}" FontSize="13"
                                           Foreground="{ThemeResource ThemeSecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>

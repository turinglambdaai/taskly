<UserControl
    x:Class="Taskly.Views.ListPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ThemeSidebarBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12" Spacing="16">

            <!-- Smart views: single quiet column (macOS Reminders sidebar style) -->
            <Grid ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" x:Name="TileToday" Click="OnTileToday"
                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                        Padding="10,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{StaticResource SmartListTodayBrush}">
                            <TextBlock x:Name="TileTodayIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="TileTodayLabel" Foreground="{ThemeResource ThemeOnSurfaceBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="TileTodayCount" Foreground="{ThemeResource ThemeSecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Button Grid.Row="1" x:Name="TilePlanned" Click="OnTilePlanned"
                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                        Padding="10,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{StaticResource SmartListScheduledBrush}">
                            <TextBlock x:Name="TilePlannedIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="TilePlannedLabel" Foreground="{ThemeResource ThemeOnSurfaceBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="TilePlannedCount" Foreground="{ThemeResource ThemeSecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Button Grid.Row="2" x:Name="TileAll" Click="OnTileAll"
                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                        Padding="10,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{StaticResource SmartListAllBrush}">
                            <TextBlock x:Name="TileAllIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="TileAllLabel" Foreground="{ThemeResource ThemeOnSurfaceBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="TileAllCount" Foreground="{ThemeResource ThemeSecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Button Grid.Row="3" x:Name="TileCompleted" Click="OnTileCompleted"
                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                        Padding="10,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{StaticResource SmartListCompletedBrush}">
                            <TextBlock x:Name="TileCompletedIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="TileCompletedLabel" Foreground="{ThemeResource ThemeOnSurfaceBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="TileCompletedCount" Foreground="{ThemeResource ThemeSecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>

            <!-- My Lists -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MyListsHeader" Grid.Column="0"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource ThemeSecondaryTextBrush}"
                           VerticalAlignment="Center" />
                <Button x:Name="AddListButton" Grid.Column="1" Click="OnAddList"
                        Background="Transparent" BorderThickness="0" Padding="4">
                    <TextBlock Text="✚" Foreground="{ThemeResource AccentBrush}" FontWeight="Bold" />
                </Button>
            </Grid>

            <ListView x:Name="ListsList" SelectionMode="None" IsItemClickEnabled="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,8" CornerRadius="8">
                            <Ellipse Width="32" Height="32">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding RowColor}" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding IconText}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PendingText}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="Taskly.Views.ListPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ThemeSidebarBrush}">

    <UserControl.Resources>
        <!-- 0.7.0-style smart tile: colored fill, glyph top-left, bold count
             top-right, semibold label bottom-left. -->
        <!-- Smart tiles are plain surfaces (no button chrome): the default
             WinUI button hover/pressed states gray out colored fills. -->
        <Style x:Key="SmartTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <!-- Full-width calendar tile (PRODUCT-SPEC §4b): 56px, no count. -->
        <Style x:Key="CalendarTile" TargetType="Border" BasedOn="{StaticResource SmartTile}">
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="TileGlyph" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TileCount" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12" Spacing="16">

            <!-- Smart view tiles (2×2, 0.7.0 layout): two-row geometry —
                 glyph + count on top, label at the bottom. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" x:Name="TileToday" Style="{StaticResource SmartTile}"
                        Background="{StaticResource SmartListTodayBrush}" Tapped="OnTileToday">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="TileTodayIcon" Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TileTodayCount" Style="{StaticResource TileCount}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TileTodayLabel" Grid.Row="1" Style="{StaticResource TileLabel}" />
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" x:Name="TilePlanned" Style="{StaticResource SmartTile}"
                        Background="{StaticResource SmartListScheduledBrush}" Tapped="OnTilePlanned">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="TilePlannedIcon" Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TilePlannedCount" Style="{StaticResource TileCount}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TilePlannedLabel" Grid.Row="1" Style="{StaticResource TileLabel}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" x:Name="TileAll" Style="{StaticResource SmartTile}"
                        Background="{StaticResource SmartListAllBrush}" Tapped="OnTileAll">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="TileAllIcon" Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TileAllCount" Style="{StaticResource TileCount}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TileAllLabel" Grid.Row="1" Style="{StaticResource TileLabel}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" x:Name="TileCompleted" Style="{StaticResource SmartTile}"
                        Background="{StaticResource SmartListCompletedBrush}" Tapped="OnTileCompleted">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="TileCompletedIcon" Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TileCompletedCount" Style="{StaticResource TileCount}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TileCompletedLabel" Grid.Row="1" Style="{StaticResource TileLabel}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Calendar tile (PRODUCT-SPEC §4b): full-width, no count badge -->
            <Border x:Name="TileCalendar" Style="{StaticResource CalendarTile}"
                    Background="{StaticResource SmartListCalendarBrush}" Tapped="OnTileCalendar">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TileCalendarIcon" Grid.Row="0" Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="TileCalendarLabel" Grid.Row="1" Style="{StaticResource TileLabel}" />
                </Grid>
            </Border>

            <!-- My Lists header + add button (0.7.0 layout) -->
            <Grid Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MyListsHeader" Grid.Column="0"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource ThemeSecondaryTextBrush}"
                           VerticalAlignment="Center" />
                <Button x:Name="AddListButton" Grid.Column="1" Click="OnAddList"
                        Background="Transparent" BorderThickness="0" Padding="4,2"
                        UseSystemFocusVisuals="False">
                    <TextBlock Text="✚" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                </Button>
            </Grid>

            <ListView x:Name="ListsList" SelectionMode="None" IsItemClickEnabled="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- 0.7.0 card row: surface fill + hairline border so rows
                             read as containers; emoji sits inside the color dot. -->
                        <Border CornerRadius="8" Padding="10,8"
                                Background="{ThemeResource ThemeSurfaceBrush}"
                                BorderBrush="{ThemeResource ThemeDividerBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding RowColor}" />
                                    </Border.Background>
                                    <TextBlock Text="{Binding IconText}" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding PendingText}" FontSize="13"
                                           Foreground="{ThemeResource ThemeSecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<ContentDialog
    x:Class="Taskly.Dialogs.TaskDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Task Detail"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel">

    <StackPanel Width="440" Spacing="10">
        <!-- Immersive editor: the task text IS the title — borderless,
             18px semibold (spec: Task detail dialog). -->
        <TextBox x:Name="TaskTextBox" AutomationProperties.Name="Task text"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxLength="1000"
                 FontSize="18" FontWeight="SemiBold"
                 BorderThickness="0" Background="Transparent" />
        <TextBox x:Name="NotesBox" AutomationProperties.Name="Task notes"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxLength="1000"
                 FontSize="13" PlaceholderText=""
                 BorderThickness="0" Background="Transparent" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <DatePicker x:Name="DatePicker" DateChanged="OnDateChanged"
                        AutomationProperties.Name="Task date" />
            <Button x:Name="ClearDateButton" Click="OnClearDate" Padding="6,2"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{ThemeResource ThemeSecondaryTextBrush}" />
            <TimePicker x:Name="TimePicker" TimeChanged="OnTimeChanged" Margin="8,0,0,0"
                        AutomationProperties.Name="Task time" />
            <Button x:Name="ClearTimeButton" Click="OnClearTime" Padding="6,2"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{ThemeResource ThemeSecondaryTextBrush}" />
        </StackPanel>
        <Button x:Name="DeleteButton" Click="OnDeleteClicked" Padding="8,4"
                Background="Transparent" BorderThickness="0"
                Foreground="{ThemeResource DangerBrush}"
                AutomationProperties.Name="Delete task" />
    </StackPanel>
</ContentDialog>

<Application
    x:Class="Taskly.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              Design tokens (shared/spec/DESIGN-TOKENS.md).
              Warm Anthropic palette as native theme dictionaries: switching
              the window's RequestedTheme flips every ThemeResource below.
            -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#F4F3EE" />
                    <SolidColorBrush x:Key="ThemeSidebarBrush" Color="#ECEAE3" />
                    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FAF9F5" />
                    <SolidColorBrush x:Key="ThemeDividerBrush" Color="#D9D6CE" />
                    <SolidColorBrush x:Key="ThemeOnSurfaceBrush" Color="#2B2825" />
                    <SolidColorBrush x:Key="ThemeSecondaryTextBrush" Color="#6B6862" />
                    <SolidColorBrush x:Key="ThemeTertiaryTextBrush" Color="#9B9890" />
                    <SolidColorBrush x:Key="ThemeSelectionBackgroundBrush" Color="#38C15F3C" />
                    <SolidColorBrush x:Key="ThemeHoverBackgroundBrush" Color="#142B2825" />
                    <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#D9D6CE" />
                    <SolidColorBrush x:Key="ThemeBadgeBackgroundBrush" Color="#E0DDD4" />
                    <SolidColorBrush x:Key="ThemeBadgeTextBrush" Color="#3C3934" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#C15F3C" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#1F1C19" />
                    <SolidColorBrush x:Key="ThemeSidebarBrush" Color="#282421" />
                    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#332F2B" />
                    <SolidColorBrush x:Key="ThemeDividerBrush" Color="#3D3935" />
                    <SolidColorBrush x:Key="ThemeOnSurfaceBrush" Color="#F4F3EE" />
                    <SolidColorBrush x:Key="ThemeSecondaryTextBrush" Color="#A8A39B" />
                    <SolidColorBrush x:Key="ThemeTertiaryTextBrush" Color="#76726B" />
                    <SolidColorBrush x:Key="ThemeSelectionBackgroundBrush" Color="#4DD47757" />
                    <SolidColorBrush x:Key="ThemeHoverBackgroundBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#4A4540" />
                    <SolidColorBrush x:Key="ThemeBadgeBackgroundBrush" Color="#4A4540" />
                    <SolidColorBrush x:Key="ThemeBadgeTextBrush" Color="#F4F3EE" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#D47757" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- Fixed semantic colors (theme-independent) -->
            <SolidColorBrush x:Key="SmartListTodayBrush" Color="#C15F3C" />
            <SolidColorBrush x:Key="SmartListScheduledBrush" Color="#B5543A" />
            <SolidColorBrush x:Key="SmartListAllBrush" Color="#8E887E" />
            <SolidColorBrush x:Key="SmartListCompletedBrush" Color="#6B8E5A" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />

            <!-- List-palette presets (fixed order, iOS system colors) -->
            <x:Array x:Key="ListPalette" Type="x:String">
                <x:String>#007AFF</x:String>
                <x:String>#FF3B30</x:String>
                <x:String>#FF9500</x:String>
                <x:String>#FFCC00</x:String>
                <x:String>#4CD964</x:String>
                <x:String>#5AC8FA</x:String>
                <x:String>#5856D6</x:String>
                <x:String>#FF2D55</x:String>
                <x:String>#8E8E93</x:String>
                <x:String>#C7C7CC</x:String>
            </x:Array>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinAppSDK 1.7 supports net8.0 only; net10.0 breaks its net472 XamlCompiler (silent exit 1). -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Taskly</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged (self-contained exe) distribution; MSIX optional. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Custom Main: CLI subcommands run before any WinUI initialization. -->
    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <!-- WinAppSDK's XAML compiler honors the constant, not the MSBuild property. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AssemblyName>Taskly</AssemblyName>
    <ApplicationIcon>Assets\taskly.ico</ApplicationIcon>
    <TasklyRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))</TasklyRepoRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseRivetBackend)' == 'true'">
    <DefineConstants>$(DefineConstants);TASKLY_RIVET</DefineConstants>
    <RivetRoot Condition="'$(RivetRoot)' == ''">$(RIVET_ROOT)</RivetRoot>
    <TasklyGeneratedRivet Condition="'$(TasklyGeneratedRivet)' == ''">$(TasklyRepoRoot)\dotnet\GeneratedBackend.cs</TasklyGeneratedRivet>
    <TasklyRivetBundle Condition="'$(TasklyRivetBundle)' == ''">$(TasklyRepoRoot)\.rivet\dotnet\windows-x64</TasklyRivetBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250401001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.7" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Unpackaged toast notifications (creates AUMID shortcut automatically). -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Auto-update framework (same family as the 0.6.x releases). -->
    <PackageReference Include="Velopack" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseRivetBackend)' == 'true'">
    <ProjectReference Include="$(RivetRoot)\platform\dotnet\Rivet.Runtime\Rivet.Runtime.csproj" />
    <Compile Include="$(TasklyGeneratedRivet)" Link="Generated\GeneratedBackend.cs" />
    <RivetBootFile Include="$(TasklyRivetBundle)\runtime\**\*.*" />
    <RivetResourceFile Include="$(TasklyRivetBundle)\res\**\*.*" />
    <RivetNativeFile Include="$(TasklyRivetBundle)\*.dll" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Strings\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- AppWindow.SetIcon reads this at runtime (unpackaged). -->
    <Content Include="Assets\taskly.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateTasklyRivet" BeforeTargets="CoreCompile" Condition="'$(UseRivetBackend)' == 'true'">
    <Error Condition="'$(RivetRoot)' == '' Or !Exists('$(RivetRoot)\platform\dotnet\Rivet.Runtime\Rivet.Runtime.csproj')"
           Text="UseRivetBackend=true requires RivetRoot (or RIVET_ROOT) to point to the pinned Rivet checkout." />
    <Error Condition="!Exists('$(TasklyGeneratedRivet)')"
           Text="Taskly generated Rivet API is missing. Run 'raco rivet build-dotnet' from the Taskly repository first." />
    <Error Condition="!Exists('$(TasklyRivetBundle)\rivet_native.dll')"
           Text="Taskly embedded Rivet bundle is missing. Run 'raco rivet build-dotnet' from the Taskly repository first." />
  </Target>

  <Target Name="CopyTasklyRivetRuntime" AfterTargets="Build" Condition="'$(UseRivetBackend)' == 'true'">
    <MakeDir Directories="$(OutDir)rivet\runtime;$(OutDir)rivet\res" />
    <Copy SourceFiles="@(RivetBootFile)"
          DestinationFiles="@(RivetBootFile->'$(OutDir)rivet\runtime\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(RivetResourceFile)"
          DestinationFiles="@(RivetResourceFile->'$(OutDir)rivet\res\%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- The native bridge and libracketcs dependency must be beside Taskly.exe
         so the Windows loader can resolve them before managed startup. -->
    <Copy SourceFiles="@(RivetNativeFile)" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
